{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "max_daily_submissions": {
      "type": "integer",
      "minimum": 0,
      "description": "Optional workspace-wide limit on attempts begun per calendar day in the configured timezone (default UTC). Omit for no daily limit; zero blocks all new begins."
    },
    "daily_channel_limits": {
      "type": "object",
      "description": "Optional per-channel daily begin caps enforced atomically alongside max_daily_submissions.",
      "properties": {
        "portal": {
          "type": "integer",
          "minimum": 0
        },
        "direct_email": {
          "type": "integer",
          "minimum": 0
        },
        "recruiter_outreach": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "description": "Explicit fail-closed automation permissions. All default to false unless explicitly enabled by the candidate.",
      "properties": {
        "auto_apply_portal": {
          "type": "boolean"
        },
        "auto_send_first_contact_email": {
          "type": "boolean"
        },
        "auto_reply_threads": {
          "type": "boolean"
        },
        "auto_book_calendar": {
          "type": "boolean"
        },
        "auto_archive_mail": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "discovery": {
      "type": "object",
      "description": "Configurable discovery sources, ATS exclusions, and role filters for job scouting.",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "minItems": 1,
          "maxItems": 50
        },
        "exclude_ats": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "maxItems": 30
        },
        "max_posting_age_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8760
        },
        "location_preferences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "maxItems": 20
        },
        "min_base_salary": {
          "type": "integer",
          "minimum": 0
        },
        "target_base_salary": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "notice_period": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "avoid_list": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 50
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "communication": {
      "type": "object",
      "description": "Candidate voice, locale, sender identity, and explicit anti-patterns for drafted/sent messages.",
      "properties": {
        "locale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "tone": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "anti_patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "maxItems": 50
        },
        "application_email": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 320
            },
            {
              "type": "null"
            }
          ]
        },
        "sender_email": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 320
            },
            {
              "type": "null"
            }
          ]
        },
        "mirror_sent_style": {
          "type": "boolean"
        },
        "sign_off": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "contact_categories": {
      "type": "array",
      "description": "Taxonomy for grouping hiring contacts and outreach leads.",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "maxItems": 20
    },
    "target_roles": {
      "type": "array",
      "description": "Role families the candidate is targeting (used during onboarding and child CV track suggestions).",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "maxItems": 20
    },
    "cv_tracks": {
      "type": "array",
      "description": "Named child CV tracks derived from the master CV (e.g. backend, product, ai).",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "maxItems": 20
    },
    "time_and_reminders": {
      "type": "object",
      "description": "Deadline, async-question cutoff, stage follow-up, and anti-spam reminder limits.",
      "properties": {
        "brief_lead_time_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 1440
        },
        "pre_interview_reminder_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 1440
        },
        "post_interview_debrief_delay_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 1440
        },
        "transcript_sources": {
          "type": "array",
          "description": "Optional connected meeting-notes or transcript sources (e.g. granola, wispr_flow, fireflies, manual_transcript).",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 20
        },
        "async_question_cutoff_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "reminder_cooldown_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 720
        },
        "max_reminders_per_item": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "applied_ghost_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "stage_followup_days": {
          "type": "object",
          "properties": {
            "applied": { "type": "integer", "minimum": 1, "maximum": 90 },
            "introduction": { "type": "integer", "minimum": 1, "maximum": 60 },
            "screening": { "type": "integer", "minimum": 1, "maximum": 60 },
            "technical": { "type": "integer", "minimum": 1, "maximum": 60 },
            "final": { "type": "integer", "minimum": 1, "maximum": 60 },
            "offer": { "type": "integer", "minimum": 1, "maximum": 30 }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "browser_policy": {
      "type": "object",
      "description": "Browser concurrency, session batching, and tab retirement policy.",
      "properties": {
        "max_concurrent_applications": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "retire_session_on_finish": {
          "type": "boolean"
        },
        "batch_form_actions": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "primary_cv": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        {
          "type": "null"
        }
      ]
    },
    "preferred_browser": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        {
          "type": "null"
        }
      ]
    },
    "answer_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      },
      "minItems": 1,
      "maxItems": 20
    }
  },
  "required": [
    "schema_version"
  ],
  "additionalProperties": false
}
